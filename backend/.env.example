# Ghostproof backend — copy to .env and fill in. NEVER commit .env.
# Test networks only. Never mainnet.

# --- server ---
PORT=8787
# Comma-separated origins allowed to call us. The frontend dev server.
CORS_ORIGINS=http://localhost:3000

# When true, /submit runs a simulated pipeline with realistic delays instead of
# a real fork run. Lets the frontend build before Foundry is wired up.
MOCK_PIPELINE=true

# --- chain ---
# Alchemy / Infura Sepolia endpoint. Used to fork and to send the payout tx.
SEPOLIA_RPC_URL=

# Owner of the BountyPool. Signs autoPayout(). Funded with Sepolia ETH.
# This key is deliberately NOT passed to the sandbox child processes.
BACKEND_PRIVATE_KEY=

# --- checker ---
# false => skip anvil and let `forge test --fork-url <sepolia>` fork directly.
# Live insurance if anvil misbehaves during the demo.
USE_ANVIL=true
# Hard kill for any forge child process.
FORGE_TIMEOUT_MS=90000
# Max accepted size of a submitted Exploit.t.sol, in bytes.
MAX_EXPLOIT_BYTES=65536

# --- AI evidence report ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=20000

# --- World ID (Simulator for the demo) ---
WORLD_APP_ID=
WORLD_ACTION_ID=verify-human

# --- Arkiv (testnet "rabdi") ---
# The @arkiv-network/sdk rabdi() chain knows its own RPC; it needs an access key
# (public RPC is heavily rate-limited) and a funded testnet account.
# Access key: https://hub.arkiv.network/access-keys   Faucet: https://hub.arkiv.network/faucet
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
# Seconds before an unanswered report auto-expires on the public record.
ARKIV_EXPIRES_IN=604800
