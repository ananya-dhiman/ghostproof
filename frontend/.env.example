# Copy to .env.local. Every value is optional.

# Person B's checker backend. Default: http://localhost:8787
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787

# Sepolia RPC for reading the pool. Default: https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# World ID widget. Must match WORLD_APP_ID / WORLD_ACTION_ID in backend/.env.
# The proof is verified by the backend (POST /verify-human), never in the browser.
NEXT_PUBLIC_WLD_APP_ID=
NEXT_PUBLIC_WLD_ACTION=verify-human
