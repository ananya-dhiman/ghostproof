# Copy to .env.local. Every value is optional: with nothing set the app runs on demo data.

# Person B's checker backend (POST /submit, GET /report/:id, GET /records)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Sepolia RPC for reading pool balance + config (falls back to a public RPC)
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# World ID (Developer Portal). Use the Simulator for the demo.
NEXT_PUBLIC_WLD_APP_ID=app_staging_xxx
NEXT_PUBLIC_WLD_ACTION=verify-human
